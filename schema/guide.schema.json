{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caffeinated1.github.io/aidatacommunitygoal/schema/guide.schema.json",
  "title": "Community Goal guide data",
  "description": "Shape of the three files in data/. build.py enforces the cross-reference rules this schema cannot express (evidence ids resolve, requirement ids are prefixed with their section).",
  "type": "object",
  "$defs": {
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "title",
        "detail",
        "type",
        "weight",
        "instruments",
        "tags"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^s[1-9][0-9]*-r[0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 8
        },
        "detail": {
          "type": "string",
          "minLength": 20
        },
        "type": {
          "enum": [
            "action",
            "commitment"
          ],
          "description": "A commitment is scored against the four pillars of the basic rule; an action is done or not."
        },
        "weight": {
          "enum": [
            1,
            2,
            3
          ],
          "description": "3 critical, 2 important, 1 supporting"
        },
        "instruments": {
          "type": "array",
          "items": {
            "enum": [
              "zoning",
              "permit",
              "agreement",
              "security",
              "utility",
              "monitoring"
            ]
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pitfall": {
          "type": "string",
          "description": "What went wrong somewhere this was missing."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "section": {
      "type": "object",
      "required": [
        "id",
        "number",
        "slug",
        "title",
        "summary",
        "goal",
        "requirements"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^s[1-9][0-9]*$"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "provenance": {
          "type": "string",
          "description": "Where a section came from when it was not carried over from the source document — who proposed it, where, and any attribution still pending."
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "required": [
        "id",
        "headline",
        "statement",
        "topic",
        "sections",
        "use",
        "verify"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ev-[a-z0-9-]+$"
        },
        "headline": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "use": {
          "type": "string",
          "description": "What the claim is good for in a hearing."
        },
        "verify": {
          "type": "string",
          "description": "How a community checks it against its own jurisdiction."
        },
        "sources": {
          "type": "array",
          "description": "Empty means the claim has not been traced to a primary source. That is counted publicly in api/v1/coverage.json rather than hidden.",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "description": "A primary document a claim was traced to. A bare link is not a citation anyone can check.",
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "The exact title of the document."
        },
        "publisher": {
          "type": "string",
          "description": "The body that published it."
        },
        "url": {
          "type": "string",
          "pattern": "^https://",
          "description": "Public link that resolves."
        },
        "date": {
          "type": "string",
          "description": "As specific as the document allows: 2024, 2024-06, 2024-06-14."
        },
        "note": {
          "type": "string",
          "description": "Where in it — table, page, section."
        }
      }
    },
    "jurisdiction": {
      "type": "object",
      "description": "One file in data/jurisdictions/. Adds local law to shared requirements; never changes or removes one.",
      "required": [
        "id",
        "name",
        "level",
        "status",
        "maintainers",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string"
        },
        "level": {
          "enum": [
            "national",
            "state",
            "province",
            "county",
            "municipality",
            "template"
          ]
        },
        "status": {
          "enum": [
            "template",
            "draft",
            "reviewed"
          ],
          "description": "reviewed only when someone qualified in this jurisdiction has checked it. The site labels anything else."
        },
        "updated": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "maintainers": {
          "type": "array",
          "minItems": 1,
          "description": "An overlay nobody maintains goes stale silently.",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "org": {
                "type": "string"
              },
              "contact": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": "object",
          "description": "Keyed by requirement id. The build rejects a key that does not resolve.",
          "propertyNames": {
            "pattern": "^s[1-9][0-9]*-r[0-9]+$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "note"
            ],
            "properties": {
              "note": {
                "type": "string",
                "description": "What the rule actually is here, in plain language."
              },
              "citation": {
                "type": "string",
                "description": "The statute or docket, with its section number."
              }
            }
          }
        }
      }
    },
    "changelogEntry": {
      "type": "object",
      "required": [
        "version",
        "date",
        "summary",
        "changes"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "summary": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "ref",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "added",
                  "changed",
                  "removed",
                  "fixed"
                ]
              },
              "ref": {
                "type": "string",
                "description": "What it touches: a section or requirement id, an evidence id, an endpoint path, or a short handle."
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    },
    "jurisdictions": {
      "type": "array",
      "description": "One object per file in data/jurisdictions/.",
      "items": {
        "$ref": "#/$defs/jurisdiction"
      }
    },
    "changelog": {
      "type": "array",
      "description": "data/changelog.json, newest first. The first entry's version must equal meta.version.",
      "items": {
        "$ref": "#/$defs/changelogEntry"
      }
    }
  }
}
